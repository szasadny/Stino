# Local development defaults — copy to .env and adjust as needed.
PORT=8080
DATA_DIR=data
# SQLx reads DATABASE_URL at COMPILE time to verify query! macros against the
# live schema. Point it at the dev DB and apply migrations once:
#   sqlx database create && sqlx migrate run   (or just run the server once)
# Alternatively build offline against the committed .sqlx cache: SQLX_OFFLINE=true.
DATABASE_URL=sqlite://data/stino.db
# Where the built frontend lives (prod). In dev, Vite serves the UI instead.
STATIC_DIR=../frontend/dist
TZ=Europe/Amsterdam
